---
import { getCollection } from "astro:content";
import Layout from "../layout/Layout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";

const projects = await getCollection("project");
const devopsProjects = projects.filter((project) => project.data.category === "devops");
const flutterProjects = projects.filter((project) => project.data.category === "flutter");
---

<Layout title="Projects">
  <section class="mx-auto px-5 pt-12 pb-24">
    <div class="mx-auto w-full max-w-6xl">
      <a href="/" class="craft-chip craft-chip--teal mb-6 hover:underline">
        <span class="emoji">←</span> Home
      </a>
      <div class="craft-card relative mb-12 px-6 py-8 sm:px-10">
        <span class="tape tape--left"></span>
        <div
          class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
        >
          <div>
            <p class="craft-eyebrow">Projects</p>
            <h1 class="mt-2 text-3xl sm:text-4xl">Things I've built &amp; shipped</h1>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href="/projects/flutter"
              class="craft-btn craft-btn--paper !py-2.5 !px-5 text-base"
            >
              <span class="emoji">📱</span> Flutter
            </a>
            <a
              href="/projects/devops"
              class="craft-btn craft-btn--paper !py-2.5 !px-5 text-base"
            >
              <span class="emoji">⚙️</span> DevOps
            </a>
          </div>
        </div>
      </div>

      <div class="space-y-14">
        <section>
          <h2 class="mb-6 text-2xl sm:text-3xl">
            <span class="emoji">📱</span> Flutter Projects
          </h2>
          <ProjectGrid projects={flutterProjects} variant="flutter" />
        </section>

        <hr class="stitch-rule" />

        <section>
          <h2 class="mb-6 text-2xl sm:text-3xl">
            <span class="emoji">⚙️</span> DevOps Projects
          </h2>
          <ProjectGrid projects={devopsProjects} variant="devops" />
        </section>
      </div>
    </div>
  </section>
</Layout>
