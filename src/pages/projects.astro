---
import { getCollection } from "astro:content";
import Layout from "../layout/Layout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { toProjectCard } from "../utils/project-cards";

const projects = await getCollection("project");
const devopsProjects = projects
  .filter((project) => project.data.category === "devops")
  .map(toProjectCard);
const mobileProjects = projects
  .filter((project) => project.data.category === "flutter")
  .map(toProjectCard);

const site = Astro.site ?? new URL("https://mfarooqzahid.github.io");
const homeUrl = new URL("/", site).href;
const pageUrl = new URL("/projects/", site).href;
const description =
  "Case studies of production systems and mobile apps: CI/CD on AWS, Kubernetes, Terraform, Flutter games, and offline-first business apps.";

const projectsJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": pageUrl,
      url: pageUrl,
      name: "DevOps and Flutter Projects by Farooq Zahid",
      description,
      isPartOf: { "@id": `${homeUrl}#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
        { "@type": "ListItem", position: 2, name: "Projects", item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="DevOps & Flutter Projects"
  description={description}
  jsonLd={projectsJsonLd}
>
  <section class="wrap page">
    <h1 class="page-title">Projects</h1>
    <p class="page-intro">
      Case studies from cloud infrastructure and mobile app work. Each one lists
      what was built and the tools used.
    </p>

    <div class="page-groups">
      <section class="project-group" aria-labelledby="devops-heading">
        <h2 id="devops-heading" class="section-title">DevOps</h2>
        <div class="section-body">
          <ProjectGrid projects={devopsProjects} />
        </div>
      </section>

      <section class="project-group" aria-labelledby="mobile-heading">
        <h2 id="mobile-heading" class="section-title">Mobile</h2>
        <div class="section-body">
          <ProjectGrid projects={mobileProjects} />
        </div>
      </section>
    </div>
  </section>
</Layout>
