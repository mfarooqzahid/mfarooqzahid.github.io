---
import { getCollection } from "astro:content";
import Layout from "../layout/Layout.astro";

const projects = await getCollection("project");
---

<Layout>
  <section class="container mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold mb-6 text-center md:text-left">Projects</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 justify-center">
      {projects.map((project) => (
        <a 
          href={`/projects/${project.slug}`} 
          class="block bg-white shadow-lg rounded-lg p-4 transition transform hover:shadow-xl border-1 border-gray-200"
        >
          {/* Image with 16:9 aspect ratio */}
          <div class="aspect-video overflow-hidden rounded-md mb-4">
            <img 
              src={project.data.image} 
              alt={project.data.title} 
              class="w-full h-full object-cover hover:scale-105 transition transform" 
            />
          </div>
          <h3 class="text-xl font-semibold mb-2">{project.data.title}</h3>
          <p class="text-gray-600 mb-4">{project.data.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.data.technologies.map((tech) => (
              <span class="inline-block bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm">
                {tech}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>