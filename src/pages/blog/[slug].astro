---
import { getCollection } from "astro:content";
import BlogLayout from "../../layout/BlogLayout.astro";
import Prose from "../../components/Prose.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }, // Pass post data as props
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<BlogLayout 
  title={post.data.title} 
  description={post.data.description || "Read this article on my blog"} 
  image={post.data.image} 
>
  <article class="min-h-screen flex flex-col">
    <div class="md:max-w-3xl w-screen mx-auto flex-grow py-20 px-6 overflow-auto">
      <!-- Title -->
      <h1 class="text-3xl font-bold mb-2">{post.data.title}</h1>
      <p class="text-gray-500">
        {post.data.date} • {post.data.tags?.join(", ")}
      </p>

      <!-- Image -->
      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="my-4 rounded-md"
        />
      )}

      <!-- Content -->
      <Prose class="w-full overflow-x-auto">
        <Content />
      </Prose>
    </div>
  </article>
</Layout>
