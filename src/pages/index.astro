---
import Layout from "../layout/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import Background from "../components/Background.astro";
import Contact from "../components/Contact.astro";
import { projects } from "../data/projects";
import { site } from "../data/site";

const siteUrl = Astro.site ?? new URL("https://mfarooqzahid.github.io");
const homeUrl = new URL("/", siteUrl).href;
const pageTitle = "Farooq Zahid, DevOps Engineer and Software Developer";
const description =
  "I build and deploy reliable systems with AWS, Docker, Terraform, Kubernetes, Linux, Go, and Flutter. Explore selected DevOps and mobile app projects.";

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${homeUrl}#person`,
      name: "Farooq Zahid",
      url: homeUrl,
      jobTitle: "DevOps Engineer and Software Developer",
      description:
        "DevOps engineer and software developer focused on reliable, scalable systems and mobile apps.",
      sameAs: [site.linkedin, site.instagram, site.github],
      knowsAbout: [
        "AWS",
        "Docker",
        "Terraform",
        "Jenkins",
        "Kubernetes",
        "Linux",
        "Flutter",
        "Go",
        "PostgreSQL",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${homeUrl}#website`,
      name: "Farooq Zahid",
      alternateName: ["mfarooqzahid.github.io"],
      url: homeUrl,
      description,
      author: { "@id": `${homeUrl}#person` },
    },
    {
      "@type": "ProfilePage",
      "@id": `${homeUrl}#webpage`,
      url: homeUrl,
      name: pageTitle,
      description,
      isPartOf: { "@id": `${homeUrl}#website` },
      mainEntity: { "@id": `${homeUrl}#person` },
    },
  ],
};
---

<Layout
  title={pageTitle}
  fullTitle
  description={description}
  jsonLd={homeJsonLd}
>
  <Hero />

  <section id="projects" class="wrap section">
    <h2 class="section-title">Projects</h2>
    <ProjectGrid projects={projects} />
  </section>

  <section id="skills" class="wrap section">
    <h2 class="section-title">Skills</h2>
    <SkillsGrid />
  </section>

  <section id="background" class="wrap section">
    <h2 class="section-title">Background</h2>
    <Background />
  </section>

  <section id="contact" class="wrap section" aria-labelledby="contact-heading">
    <Contact />
  </section>
</Layout>
