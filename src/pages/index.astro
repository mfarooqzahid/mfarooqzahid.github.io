---
import Layout from "../layout/Layout.astro";
import ContactButtons from "../components/ContactButtons.astro"
---

<Layout title="Welcome">
  <section class="h-screen flex flex-col items-center justify-center text-center text-black px-6">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-medium pb-3">Hi, I'm Farooq</h2>
      <h1 class="text-5xl font-bold">Your Trusted Ally for Flutter App Development</h1>

      <p class="text-lg mt-2 text-gray-700 pt-3">
        Welcome to my portfolio. Explore my projects, blog, and more!
      </p>

      <!-- Buttons -->
      <ContactButtons />
    </div>
  </section>
</Layout>
