---
import { getCollection } from "astro:content";
import MinimalLayout from "../../layout/MinimalLayout.astro";

export async function getStaticPaths() {
  const pages = await getCollection("custom");
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await page.render();
---

<MinimalLayout title={page.data.title}>
  <p class="not-prose back-row">
    <a class="back-link" href="/pages/">/pages</a>
  </p>

  <h1>{page.data.title}</h1>

  {page.data.tagline && <p>{page.data.tagline}</p>}

  {
    page.data.links && (
      <ul class="not-prose link-row">
        {page.data.links.map((link) => (
          <li>
            <a
              class="btn btn-secondary"
              href={link.url}
              target="_blank"
              rel="noreferrer"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {page.data.hero && <img src={page.data.hero} alt={page.data.title} />}

  <Content />

  {
    page.data.screenshots && (
      <div class="not-prose shot-row">
        {page.data.screenshots.map((screenshot) => (
          <img
            src={screenshot}
            alt={`${page.data.title} screenshot`}
            width="240"
            height="427"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    )
  }
</MinimalLayout>

<style>
  .back-row {
    margin-bottom: 24px;
    font-size: 14px;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block: 24px;
  }

  .shot-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 32px;
  }

  .shot-row img {
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    border: 1px solid var(--color-rule);
    object-fit: cover;
  }

  @media (min-width: 640px) {
    .shot-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
