---
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import Layout from "../../layout/Layout.astro";

const markdownPages = (await getCollection("custom")).map((page) => ({
  href: `/pages/${page.slug}/`,
  title: page.data.title,
  description: page.data.description,
}));

// Standalone .html files dropped straight into src/pages/pages/
// are served by Astro at /pages/<name>.
const pagesDir = path.join(process.cwd(), "src", "pages", "pages");
const htmlPages = (fs.existsSync(pagesDir) ? fs.readdirSync(pagesDir) : [])
  .filter((file) => file.endsWith(".html"))
  .map((file) => {
    const slug = file.replace(/\.html$/, "");
    const raw = fs.readFileSync(path.join(pagesDir, file), "utf-8");
    const title = raw.match(/<title>([^<]*)<\/title>/i)?.[1]?.trim() || slug;
    return {
      href: `/pages/${slug}/`,
      title,
      description: "Standalone HTML page.",
    };
  });

const pages = [...markdownPages, ...htmlPages].sort((a, b) =>
  a.title.localeCompare(b.title)
);
---

<Layout title="Pages" noindex>
  <section class="wrap page">
    <h1 class="page-title">/pages</h1>
    <p class="page-intro">
      Standalone pages that live outside the main site. Not linked from
      anywhere, reachable by URL only.
    </p>

    {
      pages.length === 0 ? (
        <p class="pages-empty">No custom pages yet.</p>
      ) : (
        <ul class="pages-list">
          {pages.map((page) => (
            <li>
              <a href={page.href}>{page.href}</a>
              <p>
                <span class="pages-title">{page.title}</span>
                <span class="pages-description">{page.description}</span>
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>

<style>
  .pages-list {
    margin-top: 32px;
    border-top: 1px solid var(--color-rule);
  }

  .pages-list li {
    padding-block: 18px;
    border-bottom: 1px solid var(--color-rule);
  }

  .pages-list a {
    color: var(--color-accent);
    font-size: 15px;
    font-weight: 500;
  }

  .pages-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pages-list p {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.5;
  }

  .pages-title {
    color: var(--color-ink);
    font-weight: 500;
  }

  .pages-description {
    color: var(--color-muted);
  }

  .pages-empty {
    margin-top: 32px;
    color: var(--color-muted);
    font-size: 15px;
  }
</style>
