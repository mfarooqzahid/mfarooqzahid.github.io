---
import { getCollection } from "astro:content";
import Layout from "../../layout/Layout.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { toProjectCard } from "../../utils/project-cards";

const projects = await getCollection("project");
const mobileProjects = projects
  .filter((project) => project.data.category === "flutter")
  .map(toProjectCard);

const site = Astro.site ?? new URL("https://mfarooqzahid.github.io");
const homeUrl = new URL("/", site).href;
const pageUrl = new URL("/projects/flutter/", site).href;
const description =
  "Flutter games and apps built by Farooq Zahid: offline puzzle games, invoicing, field service, inventory, and marketplace apps.";

const flutterJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": pageUrl,
      url: pageUrl,
      name: "Flutter Apps and Games by Farooq Zahid",
      description,
      isPartOf: { "@id": `${homeUrl}#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
        {
          "@type": "ListItem",
          position: 2,
          name: "Projects",
          item: new URL("/projects/", site).href,
        },
        { "@type": "ListItem", position: 3, name: "Flutter", item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="Flutter Apps & Games"
  description={description}
  jsonLd={flutterJsonLd}
>
  <section class="wrap page">
    <a class="back-link" href="/projects/">All projects</a>
    <h1 class="page-title">Flutter projects</h1>
    <p class="page-intro">
      Mobile apps and games built with Flutter, from offline business tools to
      published puzzle games.
    </p>

    <div class="page-groups">
      <ProjectGrid projects={mobileProjects} />
    </div>
  </section>
</Layout>
