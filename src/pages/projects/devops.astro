---
import { getCollection } from "astro:content";
import Layout from "../../layout/Layout.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { toProjectCard } from "../../utils/project-cards";

const projects = await getCollection("project");
const devopsProjects = projects
  .filter((project) => project.data.category === "devops")
  .map(toProjectCard);

const site = Astro.site ?? new URL("https://mfarooqzahid.github.io");
const homeUrl = new URL("/", site).href;
const pageUrl = new URL("/projects/devops/", site).href;
const description =
  "DevOps case studies by Farooq Zahid: CI/CD pipelines, AWS infrastructure with Terraform, Kubernetes on EKS, monitoring, and GitOps.";

const devopsJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": pageUrl,
      url: pageUrl,
      name: "DevOps and Cloud Projects by Farooq Zahid",
      description,
      isPartOf: { "@id": `${homeUrl}#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
        {
          "@type": "ListItem",
          position: 2,
          name: "Projects",
          item: new URL("/projects/", site).href,
        },
        { "@type": "ListItem", position: 3, name: "DevOps", item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="DevOps & Cloud Projects"
  description={description}
  jsonLd={devopsJsonLd}
>
  <section class="wrap page">
    <a class="back-link" href="/projects/">All projects</a>
    <h1 class="page-title">DevOps projects</h1>
    <p class="page-intro">
      Infrastructure, delivery pipelines and cloud systems I have built and run.
    </p>

    <div class="page-groups">
      <ProjectGrid projects={devopsProjects} />
    </div>
  </section>
</Layout>
