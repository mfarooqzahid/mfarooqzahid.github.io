---
import { getCollection } from "astro:content";
import Layout from "../../layout/Layout.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";

const projects = await getCollection("project");
const devopsProjects = projects.filter((project) => project.data.category === "devops");

const site = Astro.site ?? new URL("https://mfarooqzahid.github.io");
const homeUrl = new URL("/", site).href;
const pageUrl = new URL("/projects/devops/", site).href;
const description =
  "DevOps case studies by Farooq Zahid: CI/CD pipelines, AWS infrastructure with Terraform, Kubernetes on EKS, monitoring, and GitOps.";

const devopsJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": pageUrl,
      url: pageUrl,
      name: "DevOps & Cloud Projects — Farooq Zahid",
      description,
      isPartOf: { "@id": `${homeUrl}#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
        { "@type": "ListItem", position: 2, name: "Projects", item: new URL("/projects/", site).href },
        { "@type": "ListItem", position: 3, name: "DevOps", item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="DevOps & Cloud Projects"
  description={description}
  jsonLd={devopsJsonLd}
>
  <section class="mx-auto px-5 pt-12 pb-24">
    <div class="mx-auto w-full max-w-6xl">
      <a href="/" class="craft-chip craft-chip--teal mb-6 hover:underline">
        <span class="emoji">←</span> Home
      </a>
      <div class="craft-card relative mb-10 px-6 py-8 sm:px-10">
        <span class="tape tape--left"></span>
        <div
          class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
        >
          <h1 class="text-3xl sm:text-4xl">
            <span class="emoji">⚙️</span> DevOps Projects
          </h1>
          <a
            href="/projects/flutter/"
            class="craft-btn craft-btn--paper !py-2.5 !px-5 text-base w-fit"
          >
            <span class="emoji">📱</span> Flutter Projects
          </a>
        </div>
      </div>

      <ProjectGrid projects={devopsProjects} variant="devops" />
    </div>
  </section>
</Layout>
