---
import { getCollection } from "astro:content";
import Layout from "../../layout/Layout.astro";
import Prose from "../../components/Prose.astro";

export async function getStaticPaths() {
  const projects = await getCollection("project");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project: project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Layout title={project.data.title}>
  <article class="mx-auto px-5 pt-12 pb-24">
    <div class="mx-auto w-full max-w-4xl">
      <a
        href="/projects"
        class="craft-chip craft-chip--teal mb-6 hover:underline"
      >
        <span class="emoji">←</span> All projects
      </a>

      <header class="craft-card relative mb-8 px-6 py-8 sm:px-9">
        <span class="tape tape--left"></span>
        <h1 class="text-3xl sm:text-4xl">{project.data.title}</h1>
        <div class="mt-4 flex flex-wrap gap-2">
          {project.data.technologies.map((tech) => (
            <span class="craft-chip craft-chip--accent">{tech}</span>
          ))}
        </div>
      </header>

      {project.data.image && (
        <div
          class="mb-8 aspect-video overflow-hidden rounded-2xl border-2 border-craft-tan bg-craft-line shadow-[0_6px_0_#bcd2e3,0_14px_26px_#5c86a326]"
        >
          <img
            src={project.data.image}
            alt={project.data.title}
            class="h-full w-full object-cover"
          />
        </div>
      )}

      <div class="craft-card px-6 py-8 sm:px-9">
        <Prose>
          <Content />
        </Prose>
      </div>

      {project.data.screenshots && (
        <div class="mt-12">
          <h2 class="mb-6 text-2xl">
            <span class="emoji">📸</span> Screenshots
          </h2>
          <div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
            {project.data.screenshots.map((screenshot, i) => (
              <div
                class="overflow-hidden rounded-xl border-2 border-craft-tan bg-craft-paper-2 shadow-[0_5px_0_#bcd2e3] transition-transform duration-150 hover:-translate-y-1"
                style={`transform: rotate(${i % 2 === 0 ? -1 : 1}deg)`}
              >
                <img
                  src={screenshot}
                  alt={`${project.data.title} screenshot`}
                  class="h-full w-full object-cover"
                />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>
