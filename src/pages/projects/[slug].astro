---
import { getCollection } from "astro:content";
import Layout from "../../layout/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("project");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project: project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const screenshots = project.data.screenshots ?? [];

const site = Astro.site ?? new URL("https://mfarooqzahid.github.io");
const homeUrl = new URL("/", site).href;
const projectsUrl = new URL("/projects/", site).href;
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, site).href;

const seoTitle = project.data.seoTitle ?? project.data.title;
const description = project.data.seoDescription ?? project.data.description;
const image = project.data.image ?? "/assets/home-preview.png";
const typeLabel = project.data.category === "flutter" ? "Mobile" : "DevOps";

const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical,
  url: canonical,
  name: seoTitle,
  description,
  isPartOf: { "@id": `${homeUrl}#website` },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: new URL(image, site).href,
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
    { "@type": "ListItem", position: 2, name: "Projects", item: projectsUrl },
    {
      "@type": "ListItem",
      position: 3,
      name: project.data.title,
      item: canonical,
    },
  ],
};

const isFlutterApp = project.data.category === "flutter";
const isGame = project.slug === "cat-stack" || project.slug === "emoji-mashup";
const appJsonLd = isFlutterApp
  ? {
      "@context": "https://schema.org",
      "@type": "MobileApplication",
      name: project.data.title,
      description,
      url: canonical,
      image: new URL(image, site).href,
      operatingSystem: "Android",
      applicationCategory: isGame ? "GameApplication" : "BusinessApplication",
      author: {
        "@type": "Person",
        name: "Farooq Zahid",
        url: homeUrl,
      },
      ...(project.data.storeUrl
        ? { installUrl: project.data.storeUrl, sameAs: [project.data.storeUrl] }
        : {}),
    }
  : null;

const jsonLd = [
  webPageJsonLd,
  breadcrumbJsonLd,
  ...(appJsonLd ? [appJsonLd] : []),
];

const getYouTubeId = (url: string) =>
  url.match(
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([\w-]+)/
  )?.[1];

const video = project.data.video;
const videoEmbed = video
  ? `https://www.youtube.com/embed/${getYouTubeId(video) ?? ""}`
  : null;
---

<Layout
  title={seoTitle}
  description={description}
  image={image}
  type="article"
  jsonLd={jsonLd}
>
  <article class="wrap page">
    <a class="back-link" href="/projects/">All projects</a>

    <header class="article-head">
      <div class="article-labels">
        <p class="section-title">{typeLabel}</p>
        {
          project.data.status && (
            <span class="article-status">{project.data.status}</span>
          )
        }
      </div>
      <h1 class="article-title">{project.data.title}</h1>
      <p class="article-stack">{project.data.technologies.join(", ")}</p>
      {
        project.data.storeUrl && (
          <a
            href={project.data.storeUrl}
            target="_blank"
            rel="noreferrer"
            class="btn btn-primary article-store"
          >
            Get it on Google Play
          </a>
        )
      }
    </header>

    {
      project.data.diagram && (
        <figure class="article-diagram">
          <img
            src={project.data.diagram.src}
            alt={project.data.diagram.alt}
            width={project.data.diagram.width}
            height={project.data.diagram.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <a
              href={project.data.diagram.src}
              target="_blank"
              rel="noreferrer">Open diagram full size</a
            >
          </figcaption>
        </figure>
      )
    }

    {
      videoEmbed && (
        <section class="article-section" aria-labelledby="video-heading">
          <h2 id="video-heading" class="section-title">
            Video
          </h2>
          <div class="video-frame">
            <iframe
              src={videoEmbed}
              title={`${project.data.title} video`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          </div>
        </section>
      )
    }

    <div class="article-body prose">
      <Content />
    </div>

    {
      screenshots.length > 0 && (
        <section class="article-section" aria-labelledby="screenshots-heading">
          <h2 id="screenshots-heading" class="section-title">
            Screenshots
          </h2>
          <div class="shot-grid">
            {screenshots.map((screenshot, i) => (
              <button
                type="button"
                data-shot-index={i}
                aria-label={`Open screenshot ${i + 1} of ${screenshots.length}`}
                class="shot"
              >
                <img
                  src={screenshot}
                  alt={`${project.data.title} screenshot ${i + 1}`}
                  width="240"
                  height="427"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            ))}
          </div>
        </section>
      )
    }
  </article>

  {
    screenshots.length > 0 && (
      <div id="lightbox" class="lightbox" hidden>
        <button id="lb-close" class="lb-btn lb-close" aria-label="Close">
          ×
        </button>
        <button id="lb-prev" class="lb-btn lb-prev" aria-label="Previous">
          ‹
        </button>
        <button id="lb-next" class="lb-btn lb-next" aria-label="Next">
          ›
        </button>

        <div id="lightbox-track" class="lightbox-track">
          {screenshots.map((screenshot, i) => (
            <div class="lightbox-slide">
              <img
                src={screenshot}
                alt={`${project.data.title} screenshot ${i + 1}`}
                width="720"
                height="1280"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>

        <div class="lb-counter">
          <span id="lb-index">1</span> / {screenshots.length}
        </div>
      </div>
    )
  }
</Layout>

<style>
  .article-head {
    margin-top: 16px;
  }

  .article-labels {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
  }

  .article-labels .section-title {
    margin-bottom: 0;
  }

  .article-status {
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .article-title {
    margin-top: 8px;
    max-width: 24ch;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .article-stack {
    margin-top: 12px;
    max-width: 62ch;
    color: var(--color-accent);
    font-size: 14.5px;
    line-height: 1.5;
  }

  .article-store {
    margin-top: 20px;
  }

  .article-diagram {
    margin: 32px 0 0;
    border: 1px solid var(--color-rule);
    background-color: var(--color-panel);
  }

  .article-diagram img {
    display: block;
    width: 100%;
    height: auto;
  }

  .article-diagram figcaption {
    padding: 8px 12px;
    border-top: 1px solid var(--color-rule);
  }

  .article-diagram figcaption a {
    color: var(--color-muted);
    font-size: 13px;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  .article-diagram figcaption a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .article-section {
    margin-top: 40px;
  }

  .article-body {
    margin-top: 40px;
  }

  .video-frame {
    margin-top: 20px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-rule);
    background-color: var(--color-panel);
  }

  .video-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .shot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 20px;
  }

  .shot {
    padding: 0;
    border: 1px solid var(--color-rule);
    background-color: var(--color-panel);
    cursor: zoom-in;
  }

  .shot:hover {
    border-color: var(--color-accent);
  }

  .shot img {
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }

  @media (min-width: 640px) {
    .shot-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: #f4f6f9f2;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior: contain;
  }

  .lightbox-track::-webkit-scrollbar {
    display: none;
  }

  .lightbox-slide {
    display: flex;
    flex: 0 0 100%;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 56px 20px;
    scroll-snap-align: center;
  }

  .lightbox-slide img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border: 1px solid var(--color-rule);
    user-select: none;
  }

  .lb-btn {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-rule);
    background-color: var(--color-panel);
    color: var(--color-ink);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }

  .lb-btn:hover {
    border-color: var(--color-accent);
  }

  .lb-close {
    top: 16px;
    right: 16px;
    font-size: 20px;
  }

  .lb-prev {
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-next {
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-counter {
    position: absolute;
    bottom: 16px;
    left: 50%;
    z-index: 2;
    padding: 4px 12px;
    border: 1px solid var(--color-rule);
    background-color: var(--color-panel);
    color: var(--color-muted);
    font-size: 13px;
    transform: translateX(-50%);
  }

  @media (max-width: 640px) {
    .lb-prev,
    .lb-next {
      display: none;
    }
  }
</style>

<script>
  const lb = document.getElementById("lightbox");
  const track = document.getElementById("lightbox-track");
  if (lb && track) {
    const indexEl = document.getElementById("lb-index");
    const shots = Array.from(
      document.querySelectorAll<HTMLElement>("[data-shot-index]")
    );
    const total = shots.length;

    const updateCounter = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth) + 1;
      const clamped = Math.min(Math.max(i, 1), total);
      if (indexEl) indexEl.textContent = String(clamped);
    };

    const openAt = (i: number) => {
      lb.hidden = false;
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => {
        track.scrollLeft = i * track.clientWidth;
        updateCounter();
      });
    };

    const close = () => {
      lb.hidden = true;
      document.body.style.overflow = "";
    };

    const step = (dir: number) =>
      track.scrollBy({ left: dir * track.clientWidth, behavior: "smooth" });

    shots.forEach((el) =>
      el.addEventListener("click", () => openAt(Number(el.dataset.shotIndex)))
    );

    document.getElementById("lb-close")?.addEventListener("click", close);
    document.getElementById("lb-prev")?.addEventListener("click", () => step(-1));
    document.getElementById("lb-next")?.addEventListener("click", () => step(1));

    track.addEventListener("scroll", updateCounter, { passive: true });

    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });

    let dragged = false;
    track.addEventListener("click", (e) => {
      if (dragged) {
        dragged = false;
        return;
      }
      const t = e.target;
      if (
        t === track ||
        (t instanceof HTMLElement && t.classList.contains("lightbox-slide"))
      ) {
        close();
      }
    });

    let down = false;
    let startX = 0;
    let startScroll = 0;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      down = true;
      dragged = false;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.style.scrollSnapType = "none";
    });
    track.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 5) dragged = true;
      track.scrollLeft = startScroll - dx;
    });
    const endDrag = () => {
      down = false;
      track.style.scrollSnapType = "";
    };
    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointerleave", endDrag);
  }
</script>
