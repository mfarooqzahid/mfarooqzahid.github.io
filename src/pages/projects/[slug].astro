---
import { getCollection } from "astro:content";
import Layout from "../../layout/Layout.astro";
import Prose from "../../components/Prose.astro";

export async function getStaticPaths() {
  const projects = await getCollection("project");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project: project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const screenshots = project.data.screenshots ?? [];
---

<Layout title={project.data.title}>
  <article class="mx-auto px-5 pt-12 pb-24">
    <div class="mx-auto w-full max-w-4xl">
      <a
        href="/projects"
        class="craft-chip craft-chip--teal mb-6 hover:underline"
      >
        <span class="emoji">←</span> All projects
      </a>

      <header class="craft-card relative mb-8 px-6 py-8 sm:px-9">
        <span class="tape tape--left"></span>
        <h1 class="text-3xl sm:text-4xl">{project.data.title}</h1>
        <div class="mt-4 flex flex-wrap gap-2">
          {project.data.technologies.map((tech) => (
            <span class="craft-chip craft-chip--accent">{tech}</span>
          ))}
        </div>
      </header>

      {project.data.image && (
        <div
          class="mb-8 aspect-video overflow-hidden rounded-2xl border-2 border-craft-tan bg-craft-line shadow-[0_6px_0_#bcd2e3,0_14px_26px_#5c86a326]"
        >
          <img
            src={project.data.image}
            alt={project.data.title}
            class="h-full w-full object-cover"
          />
        </div>
      )}

      <div class="craft-card px-6 py-8 sm:px-9">
        <Prose>
          <Content />
        </Prose>
      </div>

      {
        screenshots.length > 0 && (
          <div class="mt-12">
            <h2 class="mb-6 text-2xl">
              <span class="emoji">📸</span> Screenshots
            </h2>
            <div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
              {screenshots.map((screenshot, i) => (
                <button
                  type="button"
                  data-shot-index={i}
                  aria-label={`Open screenshot ${i + 1} of ${screenshots.length}`}
                  class="shot group block cursor-zoom-in overflow-hidden rounded-xl border-2 border-craft-tan bg-craft-paper-2 p-0 shadow-[0_5px_0_#bcd2e3] transition-transform duration-150 hover:-translate-y-1"
                  style={`transform: rotate(${i % 2 === 0 ? -1 : 1}deg)`}
                >
                  <img
                    src={screenshot}
                    alt={`${project.data.title} screenshot ${i + 1}`}
                    class="h-full w-full object-cover"
                    draggable="false"
                  />
                </button>
              ))}
            </div>
            <p class="mt-4 text-center text-sm text-craft-muted">
              Tap a screenshot to open the slider
            </p>
          </div>
        )
      }
    </div>
  </article>

  {
    screenshots.length > 0 && (
      <div id="lightbox" class="lightbox" hidden>
        <button id="lb-close" class="lb-btn lb-close" aria-label="Close">
          ✕
        </button>
        <button id="lb-prev" class="lb-btn lb-prev" aria-label="Previous">
          ‹
        </button>
        <button id="lb-next" class="lb-btn lb-next" aria-label="Next">
          ›
        </button>

        <div id="lightbox-track" class="lightbox-track">
          {screenshots.map((screenshot, i) => (
            <div class="lightbox-slide">
              <img
                src={screenshot}
                alt={`${project.data.title} screenshot ${i + 1}`}
                draggable="false"
              />
            </div>
          ))}
        </div>

        <div class="lb-counter">
          <span id="lb-index">1</span> / {screenshots.length}
        </div>
      </div>
    )
  }
</Layout>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(18, 24, 32, 0.94);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior: contain;
  }
  .lightbox-track::-webkit-scrollbar {
    display: none;
  }
  .lightbox-slide {
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.25rem;
  }
  .lightbox-slide img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 14px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.5);
    user-select: none;
  }
  .lb-btn {
    position: absolute;
    z-index: 2;
    border: 0;
    cursor: pointer;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(4px);
    border-radius: 999px;
    width: 46px;
    height: 46px;
    font-size: 26px;
    line-height: 1;
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
    font-size: 20px;
  }
  .lb-prev {
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: #fff;
    font-family: "Baloo 2", system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    background: rgba(255, 255, 255, 0.12);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
  }
  @media (max-width: 640px) {
    .lb-prev,
    .lb-next {
      display: none;
    }
  }
</style>

<script>
  const lb = document.getElementById("lightbox");
  const track = document.getElementById("lightbox-track");
  if (lb && track) {
    const indexEl = document.getElementById("lb-index");
    const shots = Array.from(
      document.querySelectorAll<HTMLElement>("[data-shot-index]")
    );
    const total = shots.length;

    const updateCounter = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth) + 1;
      const clamped = Math.min(Math.max(i, 1), total);
      if (indexEl) indexEl.textContent = String(clamped);
    };

    const openAt = (i: number) => {
      lb.hidden = false;
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => {
        track.scrollLeft = i * track.clientWidth;
        updateCounter();
      });
    };

    const close = () => {
      lb.hidden = true;
      document.body.style.overflow = "";
    };

    const step = (dir: number) =>
      track.scrollBy({ left: dir * track.clientWidth, behavior: "smooth" });

    shots.forEach((el) =>
      el.addEventListener("click", () => openAt(Number(el.dataset.shotIndex)))
    );

    document.getElementById("lb-close")?.addEventListener("click", close);
    document.getElementById("lb-prev")?.addEventListener("click", () => step(-1));
    document.getElementById("lb-next")?.addEventListener("click", () => step(1));

    track.addEventListener("scroll", updateCounter, { passive: true });

    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });

    // click on the dark backdrop (not the image) closes
    let dragged = false;
    track.addEventListener("click", (e) => {
      if (dragged) {
        dragged = false;
        return;
      }
      const t = e.target;
      if (
        t === track ||
        (t instanceof HTMLElement && t.classList.contains("lightbox-slide"))
      ) {
        close();
      }
    });

    // desktop drag-to-scroll
    let down = false,
      startX = 0,
      startScroll = 0;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      down = true;
      dragged = false;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.style.scrollSnapType = "none";
    });
    track.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 5) dragged = true;
      track.scrollLeft = startScroll - dx;
    });
    const endDrag = () => {
      down = false;
      track.style.scrollSnapType = "";
    };
    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointerleave", endDrag);
  }
</script>
