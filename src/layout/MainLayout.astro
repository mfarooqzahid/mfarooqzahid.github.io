---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" />
  </head>
  <body class="bg-gray-100 font-sans">
    <!-- Navbar -->
    <header class="bg-gray-900 text-white p-4">
      <nav class="container mx-auto flex justify-between items-center">
        <div class="logo text-2xl font-bold">MyLogo</div>
        <ul class="hidden md:flex space-x-6">
          <li><a href="/about" class="hover:text-gray-400">About</a></li>
          <li><a href="/blog" class="hover:text-gray-400">Blog</a></li>
        </ul>
        <div class="md:hidden">
          <button id="hamburger-btn" class="text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="h-6 w-6">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </nav>
      <div id="mobile-menu" class="md:hidden hidden">
        <ul class="space-y-4 p-4">
          <li><a href="#home" class="hover:text-gray-400">Home</a></li>
          <li><a href="#about" class="hover:text-gray-400">About</a></li>
          <li><a href="#services" class="hover:text-gray-400">Services</a></li>
          <li><a href="#blog" class="hover:text-gray-400">Blog</a></li>
        </ul>
      </div>
    </header>

    <!-- Slot for page content -->
    <slot />

    <script>
      const hamburgerBtn = document.getElementById('hamburger-btn')!;
      const mobileMenu = document.getElementById('mobile-menu')!;
      hamburgerBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
