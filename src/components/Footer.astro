---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap">
    <p>{site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 56px;
    border-top: 1px solid var(--color-rule);
    padding-block: 24px 36px;
  }

  .site-footer p {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }
</style>
