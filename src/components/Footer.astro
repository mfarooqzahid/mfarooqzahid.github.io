---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap">
    <a class="footer-name" href="/">{site.name}</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 56px;
    border-top: 1px solid var(--color-rule);
    padding-block: 24px 36px;
  }

  .footer-name {
    color: var(--color-muted);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
  }

  .footer-name:hover {
    color: var(--color-ink);
  }
</style>
