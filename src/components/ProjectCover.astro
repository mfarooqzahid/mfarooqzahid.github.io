---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"project">;
  variant?: "card" | "hero";
  class?: string;
}

const { project, variant = "card", class: className } = Astro.props;
const isDevops = project.data.category === "devops";
const isHero = variant === "hero";
---

<div
  class:list={[
    "project-cover",
    isDevops && "project-cover--devops",
    isHero && "project-cover--hero",
    className,
  ]}
>
  {
    project.data.image ? (
      <img
        src={project.data.image}
        alt={project.data.title}
        class="project-cover__image transition-transform duration-300 group-hover:scale-105"
        loading={isHero ? "eager" : "lazy"}
      />
    ) : (
      <div class="project-cover__inner">
        <p class="project-cover__eyebrow">
          {isDevops ? "DevOps" : "Project"}
        </p>
        <p class="project-cover__title">{project.data.title}</p>
      </div>
    )
  }
</div>

<style>
  .project-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 2px solid var(--color-craft-tan);
    border-radius: 0.75rem;
    background: var(--color-craft-line);
  }

  .project-cover--hero {
    border-radius: 1rem;
    box-shadow: 0 6px 0 #bcd2e3, 0 14px 26px #5c86a326;
  }

  .project-cover__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-cover--devops {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    border-color: var(--color-craft-ink);
    background:
      radial-gradient(circle at 18% 12%, #ffffff1f 0 1.5px, transparent 1.6px)
        0 0 / 14px 14px,
      linear-gradient(145deg, #334961 0%, #24333f 100%);
  }

  .project-cover--devops::after {
    content: "";
    position: absolute;
    inset: 10px;
    pointer-events: none;
    border: 1.5px dashed #ffffff38;
    border-radius: 0.5rem;
  }

  .project-cover__inner {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    text-align: center;
    text-wrap: balance;
  }

  .project-cover__eyebrow {
    margin: 0 0 0.45rem;
    color: var(--color-craft-teal-dark);
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-cover__title {
    margin: 0;
    color: var(--color-craft-ink);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    line-height: 1.15;
  }

  .project-cover--devops .project-cover__eyebrow {
    color: var(--color-craft-felt);
  }

  .project-cover--devops .project-cover__title {
    color: var(--color-craft-paper);
  }

  .project-cover--hero .project-cover__eyebrow {
    margin-bottom: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.24em;
  }

  .project-cover--hero .project-cover__title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  .project-cover--hero.project-cover--devops {
    aspect-ratio: 21 / 9;
  }

  @media (max-width: 640px) {
    .project-cover--hero.project-cover--devops {
      aspect-ratio: 16 / 9;
      padding: 1rem;
    }

    .project-cover--hero .project-cover__title {
      font-size: clamp(1.3rem, 6vw, 1.8rem);
    }
  }
</style>
