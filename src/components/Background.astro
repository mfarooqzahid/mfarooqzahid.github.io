---
import { background } from "../data/background";
---

<div class="background-panel panel">
  {
    background.map((row) => (
      <div class="background-row">
        <div class="background-org">
          <h3>{row.organisation}</h3>
          <p class="background-period">{row.period}</p>
        </div>
        <p class="background-role">{row.role}</p>
      </div>
    ))
  }
</div>

<style>
  .background-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 20px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--color-rule);
  }

  .background-row:last-child {
    border-bottom: 0;
  }

  .background-org h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.6;
  }

  .background-period {
    color: var(--color-muted);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .background-role {
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .background-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
