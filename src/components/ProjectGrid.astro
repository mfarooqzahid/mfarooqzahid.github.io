---
const { projects, variant = "flutter" } = Astro.props;
const isDevops = variant === "devops";
---

<div class="grid grid-cols-1 justify-center gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {projects.map((project) => (
    <a
      href={`/projects/${project.slug}`}
      class="craft-card group relative block p-4 transition-transform duration-150 hover:-translate-y-1"
    >
      <span class="tape"></span>

      <div
        class:list={[
          "mb-4 aspect-video overflow-hidden rounded-xl border-2 border-craft-tan bg-craft-line",
          isDevops &&
            "flex items-center justify-center border-craft-ink bg-craft-ink px-6 text-center",
        ]}
      >
        {project.data.image ? (
          <img
            src={project.data.image}
            alt={project.data.title}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        ) : (
          <div>
            <p class="craft-eyebrow !text-craft-felt mb-2">
              {isDevops ? "DevOps" : "Project"}
            </p>
            <p class="font-display text-xl leading-tight !text-craft-paper">
              {project.data.title}
            </p>
          </div>
        )}
      </div>

      <h3 class="text-xl leading-snug">{project.data.title}</h3>
      <p class="mt-1 mb-4 text-craft-muted">{project.data.description}</p>

      <div class="flex flex-wrap gap-2">
        {project.data.technologies.map((tech) => (
          <span
            class:list={[
              "craft-chip",
              isDevops ? "craft-chip--teal" : "craft-chip--accent",
            ]}
          >
            {tech}
          </span>
        ))}
      </div>
    </a>
  ))}
</div>
