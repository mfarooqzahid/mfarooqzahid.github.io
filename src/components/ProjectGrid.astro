---
import type { Project } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const remainder = projects.length % 3;

const spanClass = (index: number) => {
  if (remainder === 0) return "";
  const firstOfLastRow = projects.length - remainder;
  if (index < firstOfLastRow) return "";
  return remainder === 2 ? "span-half" : "span-full";
};
---

<div class="project-grid">
  {
    projects.map((project, index) => (
      <ProjectCard project={project} class={spanClass(index)} />
    ))
  }
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1px;
    background-color: var(--color-rule);
    border: 1px solid var(--color-rule);
  }
</style>
