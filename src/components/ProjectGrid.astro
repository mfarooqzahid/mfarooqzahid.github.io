---
const { projects, variant = "flutter" } = Astro.props;
const isDevops = variant === "devops";
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 justify-center">
  {projects.map((project) => (
    <a
      href={`/projects/${project.slug}`}
      class="block bg-white shadow-lg rounded-lg p-4 transition transform hover:shadow-xl border border-gray-200"
    >
      <div class:list={[
        "aspect-video overflow-hidden rounded-md mb-4 bg-gray-100",
        isDevops && "bg-gray-900 text-white flex items-center justify-center text-center px-6",
      ]}>
        {project.data.image ? (
          <img
            src={project.data.image}
            alt={project.data.title}
            class="w-full h-full object-cover hover:scale-105 transition transform"
          />
        ) : (
          <div>
            <p class="text-sm uppercase tracking-wider text-green-300 mb-2">
              {isDevops ? "DevOps" : "Project"}
            </p>
            <p class="text-xl font-semibold leading-tight">{project.data.title}</p>
          </div>
        )}
      </div>
      <h3 class="text-xl font-semibold mb-2">{project.data.title}</h3>
      <p class="text-gray-600 mb-4">{project.data.description}</p>
      <div class="flex flex-wrap gap-2">
        {project.data.technologies.map((tech) => (
          <span class:list={[
            "inline-block px-3 py-1 rounded-full text-sm",
            isDevops ? "bg-green-50 text-green-800" : "bg-gray-100 text-gray-700",
          ]}>
            {tech}
          </span>
        ))}
      </div>
    </a>
  ))}
</div>
